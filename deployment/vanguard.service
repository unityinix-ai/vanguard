# /etc/systemd/system/vanguard.service
# Manages the Vanguard Docker Compose deployment

[Unit]
Description=Vanguard Multi-Agent System
Documentation=https://github.com/akatsuki333/vanguard
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vanguard
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
